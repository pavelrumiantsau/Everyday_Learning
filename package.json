{
  "name": "everyday-learning",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:content": "tsx scripts/build-content.ts && tsx scripts/build-llm.ts",
    "content:validate": "tsx scripts/build-content.ts --check && tsx scripts/build-llm.ts --check",
    "test": "vitest run",
    "typecheck": "pnpm build:content && pnpm -r typecheck",
    "dev": "pnpm build && pnpm --filter @el/worker dev",
    "db:migrate": "pnpm --filter @el/worker db:migrate",
    "secrets:push": "tsx scripts/secrets-push.ts",
    "setup:telegram": "tsx scripts/setup-telegram.ts",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "deploy:worker": "pnpm build && pnpm --filter @el/worker run deploy",
    "wrangler": "pnpm --filter @el/worker exec wrangler",
    "content:sources": "tsx scripts/fetch-sources.ts",
    "content:candidates": "tsx scripts/candidates.ts",
    "llm:eval": "tsx scripts/llm-eval.ts",
    "build": "pnpm build:content && pnpm --filter @el/miniapp build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
